# Configuration Environment Variables Example for SD Negeri Bobong Presensi
# Salin file ini menjadi '.env.local' dan sesuaikan nilainya.

VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Groq Cloud API Key untuk Analisis Laporan Cerdik AI (Dapatkan di console.groq.com)
VITE_GROQ_API_KEY=YOUR_GROQ_API_KEY
